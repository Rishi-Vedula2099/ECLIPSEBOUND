; Engine configuration file for ECLIPSEBOUND
; Dark Pixel-Art Action RPG & AI/RL Platform

config_version=5

[application]

config/name="ECLIPSEBOUND"
config/description="Dark pixel-art action RPG with adaptive game AI and reinforcement learning platform."
config/version="0.1.0-phase1"
run/main_scene="res://scenes/boot/Boot.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://assets/ui/icon.svg"

[autoload]

EventBus="*res://scripts/core/EventBus.gd"
TelemetryManager="*res://scripts/telemetry/TelemetryManager.gd"
CombatSystem="*res://scripts/combat/CombatSystem.gd"
SaveManager="*res://scripts/save/SaveManager.gd"
AudioManager="*res://scripts/core/AudioManager.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[rendering]

textures/canvas_textures/default_texture_filter=0
2d/snap/transform_snap_to_coords=true
2d/snap/vertices_to_coords=true

[physics]

common/physics_ticks_per_second=60
2d/default_gravity=980.0

[layer_names]

2d_physics/layer_1="Environment"
2d_physics/layer_2="Hazards"
2d_physics/layer_3="Player"
2d_physics/layer_4="Enemy"
2d_physics/layer_5="PlayerHitbox"
2d_physics/layer_6="EnemyHitbox"
2d_physics/layer_7="PlayerHurtbox"
2d_physics/layer_8="EnemyHurtbox"

